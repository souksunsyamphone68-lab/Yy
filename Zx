MainTab:CreateToggle({
   Name = "เปิด/ปิด ล็อกเป้าหมายใกล้ที่สุด",
   CurrentValue = false,
   Flag = "LockToggle",
   Callback = function(Value)
      getgenv().LockEnabled = Value
   end,
})

-- ==================== 2. ระบบตรวจสอบข้อมูลผู้เล่น ====================
MainTab:CreateSection("📋 Player Info Inspector")

local InfoLabel = MainTab:CreateLabel("เลือกผู้เล่นจากดรอปดาวน์ด้านล่าง")

local PlayerDropdown = MainTab:CreateDropdown({
   Name = "เลือกผู้เล่น",
   Options = {"Searching..."},
   CurrentOption = {""},
   Flag = "PlayerDropdown",
   Callback = function(Option)
      local selectedName = type(Option) == "table" and Option[1] or Option
      local target = Players:FindFirstChild(selectedName)
      
      if target then
         local char = target.Character
         local hum = char and char:FindFirstChild("Humanoid")
         local hrp = char and char:FindFirstChild("HumanoidRootPart")
         
         local health = hum and math.floor(hum.Health) or "N/A"
         local maxHealth = hum and math.floor(hum.MaxHealth) or "N/A"
         local team = target.Team and target.Team.Name or "ไม่มีทีม"
         local pos = hrp and string.format("%.1f, %.1f, %.1f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z) or "N/A"
         
         InfoLabel:Set(
            "ชื่อ: " .. target.Name ..
            " | HP: " .. tostring(health) .. "/" .. tostring(maxHealth) ..
            " | ทีม: " .. team ..
            " | ตำแหน่ง: " .. pos
         )
      end
   end,
})

-- อัปเดตรายชื่อผู้เล่นใน Dropdown ทุกๆ 2 วินาที
task.spawn(function()
   while task.wait(2) do
      local playerList = {}
      for _, p in pairs(Players:GetPlayers()) do
         table.insert(playerList, p.Name)
      end
      PlayerDropdown:Refresh(playerList)
   end
end)

